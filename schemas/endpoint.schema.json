{
  "$defs": {
    "ApiProtocol": {
      "enum": [
        "rest"
      ],
      "title": "ApiProtocol",
      "type": "string"
    },
    "BodyMatch": {
      "enum": [
        "none",
        "subset",
        "exact"
      ],
      "title": "BodyMatch",
      "type": "string"
    },
    "HttpMethod": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ],
      "title": "HttpMethod",
      "type": "string"
    },
    "ValidationSpec": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected HTTP status code.",
          "title": "Status"
        },
        "body": {
          "$ref": "#/$defs/BodyMatch",
          "default": "none",
          "description": "How the response body is compared with the response file. none: not at all. subset: everything in the file must be in the response, which may have more keys and more list items. exact: the response must equal the file."
        }
      },
      "title": "ValidationSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An endpoint's meta.yaml. Endpoints are building blocks: only scenarios run.",
  "properties": {
    "path": {
      "description": "URL path, e.g. /orders/{{order_id}}.",
      "title": "Path",
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/ApiProtocol",
      "default": "rest",
      "description": "API style of the endpoint."
    },
    "method": {
      "$ref": "#/$defs/HttpMethod",
      "default": "GET",
      "description": "HTTP method."
    },
    "query": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "default": {},
      "description": "Query string parameters; values may use {{placeholders}}. A null value is not sent.",
      "title": "Query",
      "type": "object"
    },
    "headers": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Request headers; values may use {{placeholders}}.",
      "title": "Headers",
      "type": "object"
    },
    "extract": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Values to take from the response for later steps: variable name to JSONPath.",
      "title": "Extract",
      "type": "object"
    },
    "validate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Checks on the response. Without it, only connection errors and status >= 400 fail."
    },
    "vars": {
      "additionalProperties": true,
      "default": {},
      "description": "Values for {{placeholders}}. The most specific wins: step, then scenario, then endpoint; data rows and extracted values come on top. A null value leaves the header, query parameter or JSON value it fills out of the request.",
      "title": "Vars",
      "type": "object"
    }
  },
  "required": [
    "path"
  ],
  "title": "EndpointFile",
  "type": "object"
}
